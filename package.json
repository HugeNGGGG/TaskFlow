{
  "name": "task-guild",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @task-guild/api start:dev",
    "dev:web": "pnpm --filter @task-guild/web dev:h5"
  }
}
